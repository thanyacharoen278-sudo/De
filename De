pages["หน้าหลัก"].Visible = true

local function openPage(name)
	for _, p in pairs(pages) do
		p.Visible = false
	end
	if pages[name] then
		pages[name].Visible = true
	end
end

local function addButton(text, pageName)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 36)
	b.BackgroundColor3 = Color3.fromRGB(25, 70, 160)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.Text = text
	b.AutoButtonColor = false
	b.Parent = side
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.18), {
			BackgroundColor3 = Color3.fromRGB(0, 160, 255)
		}):Play()
	end)

	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.18), {
			BackgroundColor3 = Color3.fromRGB(25, 70, 160)
		}):Play()
	end)

	b.MouseButton1Click:Connect(function()
		openPage(pageName)
	end)
end

