refreshBtn.MouseButton1Click:Connect(function()
	updateWeaponList()
	if #weaponList > 0 then
		currentIndex = 1
		selectedWeapon = weaponList[1]
		weaponBtn.Text = selectedWeapon
	else
		weaponBtn.Text = "ไม่มีอาวุธ"
		selectedWeapon = nil
	end
end)

weaponBtn.MouseButton1Click:Connect(function()
	updateWeaponList()
	if #weaponList == 0 then
		weaponBtn.Text = "ไม่มีอาวุธ"
		return
	end
	currentIndex = currentIndex + 1
	if currentIndex > #weaponList then
		currentIndex = 1
	end
	selectedWeapon = weaponList[currentIndex]
	weaponBtn.Text = selectedWeapon
end)

